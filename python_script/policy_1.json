{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": {
        "ec2":"DescribeInstances",
        "ec2:DescribeInstanceStatus":
        "ec2:DescribeVolumes"
    },
      "Resource": "*"
    },
    {
      "Effect": "Allow",
      "Action": {
        "ec2:StartInstances":
        "ec2:StopInstances",
        "ec2": "RebootInstances"
      },
      "Resource": "*"
    },
    {
      "Effect": "Allow",
      "Action": {
        "s3:ListBucket":
        "s3:GetObject",
        "s3": "PutObject"
      },
      "Resource": "*"
    },
    {
      "Effect": "Allow",
      "Action": {
        "route53":"ListHostedZones",
        "route53:ListResourceRecordSets":
        "route53:ChangeResourceRecordSets"
    },
      "Resource": "*"
    },
    {
      "Effect": "Deny",
      "Action": {
        "ec2": "TerminateInstances"
    },
      "Resource": "*"
    },
    {
      "Effect": "Deny",
      "Action": {
        "s3:DeleteBucket":
        "s3:DeleteObject"
    },
      "Resource": "*"
    },
    {
      "Effect": "Deny",
      "Action": {
        "route53": "DeleteHostedZone"
      },
      "Resource": "*"
    }
  ]
}
import logparser
import posixpath

accessLogFile = "access.log"

accessLog = open (accessLogFile, 'r')

pathCounter = {}

for logLine in accessLog:

    logParts = logparser.parser(logLine)

    path = logParts['request'].split()[1]

    status = logParts['status']

    if status == '404':

      if path not in pathCounter:

        pathCounter[path] = 1

      else:

        pathCounter[path] = pathCounter[path] + 1

accessLog.close()

def get_freq(t):
  
  return t[1]

result = sorted(pathCounter.items(), key= get_freq)[-5:] #slicing method [-5:] print last 5 results, [1:12] will get first 13 elements

for item in result:
  
  path = item[0]

  freq = item[1]

  print(f' {freq:5} - {path}')